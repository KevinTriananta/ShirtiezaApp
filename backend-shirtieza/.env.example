# Environment variables
# Database
# Production deploys should set DATABASE_DSN directly.
# Use Supabase PostgreSQL for production.
# Example Supabase DSN:
# DATABASE_DSN=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Example MySQL DSN:
# DATABASE_DSN=user:password@tcp(host:3306)/shirtieza_db?charset=utf8mb4&parseTime=True&loc=Local
DATABASE_DSN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shirtieza_db
DB_DRIVER=mysql # postgres, mysql

# Server
SERVER_PORT=8080
SERVER_ENV=development # development, production

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=24 # hours

# Initial admin user
# In production, ADMIN_PASSWORD must be set or admin seeding is skipped.
ADMIN_EMAIL=admin@shirtieza.com
ADMIN_NAME=Shirtieza Admin
ADMIN_PASSWORD=

# CORS
# Add your Vercel domain here after frontend deploy.
# Example: CORS_ALLOWED_ORIGINS=https://shirtieza.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE=10 # MB
UPLOAD_PATH=./uploads

# Pagination
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=100

# Example production value: https://shirtieza.vercel.app
FRONTEND_URL=http://localhost:5173
